+// MARK: - AI Advisor
+
+struct AIAdvisorDisplay: Identifiable, Equatable {
+    let id: UUID
+    let title: String
+    let detail: String
+    let startHour: Int
+    let endHour: Int
+    let currentValue: Double?
+    let suggestedValue: Double
+
+    init(id: UUID = UUID(), title: String, detail: String, startHour: Int, endHour: Int, currentValue: Double?, suggestedValue: Double) {
+        self.id = id
+        self.title = title
+        self.detail = detail
+        self.startHour = startHour
+        self.endHour = endHour
+        self.currentValue = currentValue
+        self.suggestedValue = suggestedValue
+    }
+}
+
+final class AIAdvisorService {
+
+    private weak var deviceManager: DeviceDataManager?
+
+    private struct HourlyStat {
+        let hour: Int
+        let median: Double
+        let percentAbove: Double
+        let percentBelow: Double
+        let days: Int
+    }
+
+    private struct Profile {
+        let hours: [HourlyStat]
+        let targetLow: Double
+        let targetHigh: Double
+        let dayCount: Int
+    }
+
+    private struct Suggestion {
+        let startHour: Int
+        let endHour: Int
+        let currentValue: Double
+        let suggestedValue: Double
+        let rationale: String
+        let confidence: Double
+    }
+
+    private struct AISuggestion: Decodable {
+        let parameter: String?
+        let startHour: Int
+        let endHour: Int
+        let suggestedValue: Double
+        let rationale: String
+        let confidence: Double?
+    }
+
+    static let apiKeyDefaultsKey = "AIAdvisor.anthropicAPIKey"
+
+    static var storedAPIKey: String {
+        get { UserDefaults.standard.string(forKey: apiKeyDefaultsKey) ?? "" }
+        set { UserDefaults.standard.set(newValue, forKey: apiKeyDefaultsKey) }
+    }
+
+    init(deviceManager: DeviceDataManager) {
+        self.deviceManager = deviceManager
+    }
+
+    func suggestions(days: Int = 14) async -> [AIAdvisorDisplay] {
+        guard let deviceManager else { return [] }
+        let end = Date()
+        let start = end.addingTimeInterval(-Double(days) * 86400)
+        guard let samples = try? await deviceManager.glucoseStore.getGlucoseSamples(start: start, end: end), !samples.isEmpty else {
+            return []
+        }
+        let points = samples.map { (date: $0.startDate, mgdl: $0.quantity.doubleValue(for: .milligramsPerDeciliter)) }
+        let profile = AIAdvisorService.profile(points: points)
+        guard let schedule = deviceManager.loopManager.settings.basalRateSchedule else { return [] }
+        let midnight = Calendar.current.startOfDay(for: end)
+        let currentBasal = (0..<24).map { schedule.value(at: midnight.addingTimeInterval(Double($0) * 3600)) }
+
+        var suggestions = AIAdvisorService.statisticalSuggestions(profile: profile, currentBasal: currentBasal)
+
+        let key = AIAdvisorService.storedAPIKey
+        if !key.isEmpty, let ai = await AIAdvisorService.aiSuggestions(profile: profile, currentBasal: currentBasal, apiKey: key), !ai.isEmpty {
+            suggestions = AIAdvisorService.reconcile(ai: ai, baseline: suggestions)
+        }
+
+        let maxBasal = deviceManager.loopManager.settings.maximumBasalRatePerHour
+        return suggestions.map { suggestion in
+            var value = suggestion.suggestedValue
+            if let maxBasal { value = Swift.min(value, maxBasal) }
+            let detail = String(format: "Baza %02d:00-%02d:00: %.2f → %.2f U/h", suggestion.startHour, suggestion.endHour, suggestion.currentValue, value)
+            return AIAdvisorDisplay(title: suggestion.rationale, detail: detail, startHour: suggestion.startHour, endHour: suggestion.endHour, currentValue: suggestion.currentValue, suggestedValue: value)
+        }
+    }
+
+    func applyBasal(_ display: AIAdvisorDisplay) {
+        guard let deviceManager, let schedule = deviceManager.loopManager.settings.basalRateSchedule else { return }
+        let midnight = Calendar.current.startOfDay(for: Date())
+        let current = (0..<24).map { schedule.value(at: midnight.addingTimeInterval(Double($0) * 3600)) }
+        var updated = current
+        var hour = ((display.startHour % 24) + 24) % 24
+        let end = ((display.endHour % 24) + 24) % 24
+        var guardCount = 0
+        repeat {
+            updated[hour] = display.suggestedValue
+            hour = (hour + 1) % 24
+            guardCount += 1
+        } while hour != end && guardCount <= 24
+
+        let items = AIAdvisorService.mergedItems(hourlyValues: updated)
+        guard let newSchedule = BasalRateSchedule(dailyItems: items, timeZone: TimeZone.current) else { return }
+        deviceManager.loopManager.mutateSettings { $0.basalRateSchedule = newSchedule }
+        deviceManager.syncBasalRateSchedule(items: items) { _ in }
+    }
+
+    private static func mergedItems(hourlyValues: [Double]) -> [RepeatingScheduleValue<Double>] {
+        var items: [RepeatingScheduleValue<Double>] = []
+        var previous: Double?
+        for hour in 0..<24 {
+            let value = hourlyValues[hour]
+            if previous == nil || abs(value - previous!) > 1e-9 {
+                items.append(RepeatingScheduleValue(startTime: TimeInterval(hour * 3600), value: value))
+                previous = value
+            }
+        }
+        return items
+    }
+
+    private static func profile(points: [(date: Date, mgdl: Double)]) -> Profile {
+        let calendar = Calendar.current
+        var buckets: [Int: [Double]] = [:]
+        var days: [Int: Set<Date>] = [:]
+        var allDays = Set<Date>()
+        for point in points {
+            let hour = calendar.component(.hour, from: point.date)
+            buckets[hour, default: []].append(point.mgdl)
+            days[hour, default: []].insert(calendar.startOfDay(for: point.date))
+            allDays.insert(calendar.startOfDay(for: point.date))
+        }
+        let targetLow = 70.0
+        let targetHigh = 180.0
+        let hours = (0..<24).map { hour -> HourlyStat in
+            let values = (buckets[hour] ?? []).sorted()
+            let median = AIAdvisorService.percentile(values, 0.5)
+            let above = values.isEmpty ? 0 : Double(values.filter { $0 > targetHigh }.count) / Double(values.count)
+            let below = values.isEmpty ? 0 : Double(values.filter { $0 < targetLow }.count) / Double(values.count)
+            return HourlyStat(hour: hour, median: median, percentAbove: above, percentBelow: below, days: days[hour]?.count ?? 0)
+        }
+        return Profile(hours: hours, targetLow: targetLow, targetHigh: targetHigh, dayCount: allDays.count)
+    }
+
+    private static func percentile(_ sorted: [Double], _ p: Double) -> Double {
+        guard !sorted.isEmpty else { return 0 }
+        if sorted.count == 1 { return sorted[0] }
+        let rank = p * Double(sorted.count - 1)
+        let low = Int(rank.rounded(.down))
+        let high = Int(rank.rounded(.up))
+        if low == high { return sorted[low] }
+        let fraction = rank - Double(low)
+        return sorted[low] * (1 - fraction) + sorted[high] * fraction
+    }
+
+    private static func statisticalSuggestions(profile: Profile, currentBasal: [Double]) -> [Suggestion] {
+        var direction = [Int](repeating: 0, count: 24)
+        for hour in profile.hours {
+            let high = hour.days >= 3 && hour.median > profile.targetHigh + 20 && hour.percentAbove >= 0.4
+            let low = hour.days >= 3 && hour.median < profile.targetLow && hour.percentBelow >= 0.2
+            if high {
+                direction[hour.hour] = 1
+            } else if low {
+                direction[hour.hour] = -1
+            }
+        }
+        let startOffset = (0..<24).first(where: { direction[$0] == 0 }) ?? 0
+        var blocks: [(dir: Int, hours: [Int])] = []
+        var current: (dir: Int, hours: [Int])?
+        for offset in 0..<24 {
+            let hour = (startOffset + offset) % 24
+            let dir = direction[hour]
+            if dir == 0 {
+                if let pending = current { blocks.append(pending); current = nil }
+                continue
+            }
+            if var pending = current, pending.dir == dir {
+                pending.hours.append(hour)
+                current = pending
+            } else {
+                if let previous = current { blocks.append(previous) }
+                current = (dir: dir, hours: [hour])
+            }
+        }
+        if let pending = current { blocks.append(pending) }
+
+        return blocks.compactMap { block -> Suggestion? in
+            guard let first = block.hours.first, let last = block.hours.last else { return nil }
+            let expected = block.hours.reduce(0.0) { $0 + currentBasal[$1] } / Double(block.hours.count)
+            let factor = block.dir > 0 ? 1.1 : 0.85
+            var suggested = expected * factor
+            suggested = Swift.max(expected - 0.3, Swift.min(suggested, expected + 0.3))
+            suggested = (suggested * 20).rounded() / 20
+            let delta = suggested - expected
+            guard abs(delta) >= 0.025 else { return nil }
+            let endHour = (last + 1) % 24
+            let medians = block.hours.map { profile.hours[$0].median }
+            let averageMedian = medians.reduce(0, +) / Double(medians.count)
+            let rationale: String
+            if block.dir > 0 {
+                rationale = String(format: "Godziny %02d:00-%02d:00: stale podwyższone (mediana %.0f mg/dL). Zwiększ bazę o %.2f U/h.", first, endHour, averageMedian, delta)
+            } else {
+                rationale = String(format: "Godziny %02d:00-%02d:00: stale obniżone (mediana %.0f mg/dL). Zmniejsz bazę o %.2f U/h.", first, endHour, averageMedian, abs(delta))
+            }
+            let days = block.hours.map { profile.hours[$0].days }.min() ?? 0
+            return Suggestion(startHour: first, endHour: endHour, currentValue: expected, suggestedValue: suggested, rationale: rationale, confidence: Swift.min(1, Double(days) / 7))
+        }
+    }
+
+    private static func aiSuggestions(profile: Profile, currentBasal: [Double], apiKey: String) async -> [AISuggestion]? {
+        guard let url = URL(string: "https://api.anthropic.com/v1/messages") else { return nil }
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.timeoutInterval = 45
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue(apiKey, forHTTPHeaderField: "x-api-key")
+        request.setValue("2023-06-01", forHTTPHeaderField: "anthropic-version")
+
+        let table = profile.hours.map { String(format: "%02d:00 mediana=%.0f powyżej=%.0f%% poniżej=%.0f%% dni=%d", $0.hour, $0.median, $0.percentAbove * 100, $0.percentBelow * 100, $0.days) }.joined(separator: "\n")
+        let basal = (0..<24).map { String(format: "%02d:00=%.2f", $0, currentBasal[$0]) }.joined(separator: " ")
+        let system = "Jesteś asystentem terapii cukrzycy typu 1. Odpowiadaj WYŁĄCZNIE w JSON: tablica obiektów {\"parameter\":\"basal\",\"startHour\":0-23,\"endHour\":0-23,\"suggestedValue\":liczba,\"rationale\":\"krótko po polsku\",\"confidence\":0-1}. Bez tekstu poza JSON."
+        let user = "Zakres docelowy 70-180 mg/dL. Dni: \(profile.dayCount). Aktualna baza: \(basal).\nProfil:\n\(table)\nZaproponuj zmiany bazy (maks. ±0.3 U/h)."
+        let body: [String: Any] = ["model": "claude-3-5-sonnet-latest", "max_tokens": 1024, "system": system, "messages": [["role": "user", "content": user]]]
+        request.httpBody = try? JSONSerialization.data(withJSONObject: body)
+
+        guard let (data, response) = try? await URLSession.shared.data(for: request),
+              let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode),
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let content = object["content"] as? [[String: Any]] else { return nil }
+        let text = content.compactMap { $0["text"] as? String }.joined()
+        guard let start = text.firstIndex(of: "["), let end = text.lastIndex(of: "]"), start < end,
+              let jsonData = String(text[start...end]).data(using: .utf8) else { return nil }
+        return try? JSONDecoder().decode([AISuggestion].self, from: jsonData)
+    }
+
+    private static func reconcile(ai: [AISuggestion], baseline: [Suggestion]) -> [Suggestion] {
+        return ai.map { item in
+            let current = baseline.first(where: { $0.startHour == item.startHour && $0.endHour == item.endHour })?.currentValue
+            var suggested = item.suggestedValue
+            if let current {
+                suggested = Swift.max(current - 0.3, Swift.min(suggested, current + 0.3))
+            }
+            return Suggestion(startHour: item.startHour, endHour: item.endHour, currentValue: current ?? suggested, suggestedValue: suggested, rationale: item.rationale, confidence: item.confidence ?? 0.5)
+        }
+    }
+}
