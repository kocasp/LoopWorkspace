diff --git a/Loop/Loop/Managers/Therapy Insights/TherapyInsightsAIClient.swift b/Loop/Loop/Managers/Therapy Insights/TherapyInsightsAIClient.swift
new file mode 100644
index 0000000..59a9f3c
--- /dev/null
+++ b/Loop/Loop/Managers/Therapy Insights/TherapyInsightsAIClient.swift	
@@ -0,0 +1,238 @@
+//
+//  TherapyInsightsAIClient.swift
+//  Loop
+//
+//  Copyright © 2026 LoopKit Authors. All rights reserved.
+//
+
+import Foundation
+
+enum TherapyInsightsProvider: String, CaseIterable, Identifiable {
+    case claude
+    case deepSeek
+    case gitHubModels
+
+    var id: String { rawValue }
+
+    var displayName: String {
+        switch self {
+        case .claude: return "Claude (Anthropic)"
+        case .deepSeek: return "DeepSeek"
+        case .gitHubModels: return "GitHub Models (Copilot)"
+        }
+    }
+
+    var defaultModel: String {
+        switch self {
+        case .claude: return "claude-opus-5-5"
+        case .deepSeek: return "deepseek-chat"
+        case .gitHubModels: return "openai/gpt-4.1"
+        }
+    }
+
+    var apiKeyPlaceholder: String {
+        switch self {
+        case .claude: return "sk-ant-…"
+        case .deepSeek: return "sk-…"
+        case .gitHubModels: return "github_pat_…"
+        }
+    }
+
+    var apiKeyInstructions: String {
+        switch self {
+        case .claude:
+            return NSLocalizedString("Create an API key at console.anthropic.com → API Keys.", comment: "Instructions for obtaining a Claude API key")
+        case .deepSeek:
+            return NSLocalizedString("Create an API key at platform.deepseek.com → API keys.", comment: "Instructions for obtaining a DeepSeek API key")
+        case .gitHubModels:
+            return NSLocalizedString("GitHub Copilot has no public API for personal use; GitHub Models is the equivalent. Create a fine-grained personal access token at github.com → Settings → Developer settings with the \"Models: read\" permission.", comment: "Instructions for obtaining a GitHub Models token")
+        }
+    }
+
+    var endpoint: URL {
+        switch self {
+        case .claude: return URL(string: "https://api.anthropic.com/v1/messages")!
+        case .deepSeek: return URL(string: "https://api.deepseek.com/chat/completions")!
+        case .gitHubModels: return URL(string: "https://models.github.ai/inference/chat/completions")!
+        }
+    }
+}
+
+enum TherapyInsightsAIError: LocalizedError, Equatable {
+    case missingAPIKey
+    case http(status: Int, message: String)
+    case refused
+    case emptyResponse
+
+    var errorDescription: String? {
+        switch self {
+        case .missingAPIKey:
+            return NSLocalizedString("Enter an API key first.", comment: "Error when no AI API key is configured")
+        case .http(let status, let message):
+            return String(format: NSLocalizedString("The AI service returned an error (%1$d): %2$@", comment: "Error from AI service (1: HTTP status, 2: message)"), status, message)
+        case .refused:
+            return NSLocalizedString("The AI model declined to answer this request.", comment: "Error when the AI model refuses")
+        case .emptyResponse:
+            return NSLocalizedString("The AI service returned an empty response.", comment: "Error when the AI response has no text")
+        }
+    }
+}
+
+struct TherapyInsightsAIClient {
+    private let session: URLSession
+
+    init(session: URLSession? = nil) {
+        if let session {
+            self.session = session
+        } else {
+            // Analysis can take a few minutes
+            let configuration = URLSessionConfiguration.default
+            configuration.timeoutIntervalForRequest = 600
+            configuration.timeoutIntervalForResource = 900
+            self.session = URLSession(configuration: configuration)
+        }
+    }
+
+    func recommendations(provider: TherapyInsightsProvider, model: String, apiKey: String, system: String, prompt: String) async throws -> String {
+        let request = try Self.makeRequest(provider: provider, model: model, apiKey: apiKey, system: system, prompt: prompt)
+        let (data, response) = try await session.data(for: request)
+
+        if let http = response as? HTTPURLResponse, !(200..<300).contains(http.statusCode) {
+            throw TherapyInsightsAIError.http(status: http.statusCode, message: Self.errorMessage(from: data))
+        }
+
+        return try Self.parseResponse(provider: provider, data: data)
+    }
+
+    static func makeRequest(provider: TherapyInsightsProvider, model: String, apiKey: String, system: String, prompt: String) throws -> URLRequest {
+        let apiKey = apiKey.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !apiKey.isEmpty else {
+            throw TherapyInsightsAIError.missingAPIKey
+        }
+
+        var request = URLRequest(url: provider.endpoint)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+
+        var body: [String: Any]
+        switch provider {
+        case .claude:
+            request.setValue(apiKey, forHTTPHeaderField: "x-api-key")
+            request.setValue("2023-06-01", forHTTPHeaderField: "anthropic-version")
+            body = [
+                "model": model,
+                "max_tokens": 16000,
+                "system": system,
+                "messages": [["role": "user", "content": prompt]]
+            ]
+            if supportsEffortAndFallbacks(claudeModel: model) {
+                body["output_config"] = ["effort": "high"]
+                // Re-run on another model server-side if a safety classifier declines the request
+                request.setValue("server-side-fallback-2026-07-01", forHTTPHeaderField: "anthropic-beta")
+                body["fallbacks"] = "default"
+            }
+        case .deepSeek, .gitHubModels:
+            request.setValue("Bearer \(apiKey)", forHTTPHeaderField: "Authorization")
+            if provider == .gitHubModels {
+                request.setValue("application/vnd.github+json", forHTTPHeaderField: "Accept")
+                request.setValue("2022-11-28", forHTTPHeaderField: "X-GitHub-Api-Version")
+            }
+            body = [
+                "model": model,
+                "messages": [
+                    ["role": "system", "content": system],
+                    ["role": "user", "content": prompt]
+                ]
+            ]
+            if provider == .deepSeek {
+                body["max_tokens"] = 8000
+            }
+        }
+
+        request.httpBody = try JSONSerialization.data(withJSONObject: body)
+        return request
+    }
+
+    private static func supportsEffortAndFallbacks(claudeModel model: String) -> Bool {
+        model.hasPrefix("claude-opus-5") || model.hasPrefix("claude-fable-5") || model == "claude-sonnet-5-5"
+    }
+
+    static func parseResponse(provider: TherapyInsightsProvider, data: Data) throws -> String {
+        let json = try JSONSerialization.jsonObject(with: data) as? [String: Any] ?? [:]
+
+        let text: String
+        switch provider {
+        case .claude:
+            if json["stop_reason"] as? String == "refusal" {
+                throw TherapyInsightsAIError.refused
+            }
+            let blocks = json["content"] as? [[String: Any]] ?? []
+            text = blocks.filter { $0["type"] as? String == "text" }.compactMap { $0["text"] as? String }.joined()
+        case .deepSeek, .gitHubModels:
+            let choices = json["choices"] as? [[String: Any]] ?? []
+            let message = choices.first?["message"] as? [String: Any]
+            text = message?["content"] as? String ?? ""
+        }
+
+        guard !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+            throw TherapyInsightsAIError.emptyResponse
+        }
+        return text
+    }
+
+    private static func errorMessage(from data: Data) -> String {
+        if let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] {
+            if let error = json["error"] as? [String: Any], let message = error["message"] as? String {
+                return message
+            }
+            if let message = json["message"] as? String {
+                return message
+            }
+        }
+        return String(decoding: data.prefix(500), as: UTF8.self)
+    }
+}
+
+enum TherapyInsightsPrompt {
+    static let system = """
+    You are an experienced diabetes educator reviewing data from a person with type 1 diabetes who uses Loop, \
+    an open-source automated insulin delivery app. Loop adjusts insulin every 5 minutes using the person's therapy settings \
+    (basal rates, insulin sensitivity factor, carb ratios, correction range), so mis-set values show up as patterns in how \
+    much Loop has to deviate from them.
+
+    How to read the data:
+    - Basal: compare deliveredBasalUnitsPerHour and automaticBolusUnitsPerHour to scheduledBasalUnitsPerHour per hour of day. \
+    Loop consistently delivering well above schedule at certain hours (with glucose still high) suggests basal is too low there; \
+    consistently well below schedule or suspended (with lows) suggests basal is too high. Remember insulin acts with a 1–2 h delay, \
+    so changes should be applied 1–2 h before the pattern. Overnight drift without carbs is the cleanest basal signal.
+    - Insulin sensitivity factor: compare medianObservedSensitivityMgdLPerUnit with the scheduled value. This is approximate \
+    (insulin on board and activity are not controlled), so weigh it by the number of episodes.
+    - Carb ratio: large rises after meals that end high after 3 h suggest a stronger ratio (fewer g/U); \
+    lows within 4 h after meals suggest a weaker ratio (more g/U). Consider whether a pattern may be explained by basal instead.
+    - Glucose metrics follow the international consensus targets: time in range 70–180 mg/dL > 70%, below 70 < 4%, below 54 < 1%, CV ≤ 36%.
+
+    Rules:
+    - Only recommend changes that the data supports, and say how strong the evidence is. If there is too little data, say so.
+    - Recommend small, incremental changes (typically 5–10%, at most 20%), one setting type at a time, starting with whatever causes lows. \
+    Give concrete proposed values next to current values, by time of day.
+    - Never recommend changes that increase hypoglycemia risk when time below range is already above target.
+    - These are suggestions to discuss with the person's diabetes care team, not medical instructions. Say so once, briefly.
+
+    Format the answer in Markdown with these sections: Summary, Basal rates, Insulin sensitivity, Carb ratios, \
+    Correction range and other settings, What to watch next. Keep it concise.
+    """
+
+    static func user(reportJSON: String, displayGlucoseUnit: String, language: String) -> String {
+        """
+        Here is a summary of my Loop data. All glucose values in the data are in mg/dL; insulin in units (U); carbs in grams.
+
+        <loop_data>
+        \(reportJSON)
+        </loop_data>
+
+        Please analyze it and recommend changes to my therapy settings. \
+        I use \(displayGlucoseUnit) for glucose, so express glucose values and insulin sensitivity in \(displayGlucoseUnit) (1 mmol/L = 18.02 mg/dL). \
+        Write the answer in this language: \(language).
+        """
+    }
+}
