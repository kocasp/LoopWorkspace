+//
+//  TherapyInsightsReportTests.swift
+//  LoopTests
+//
+//  Copyright © 2026 LoopKit Authors. All rights reserved.
+//
+
+import XCTest
+import HealthKit
+import LoopKit
+@testable import Loop
+
+class TherapyInsightsReportTests: XCTestCase {
+    private let utc = TimeZone(identifier: "UTC")!
+    private let start = ISO8601DateFormatter().date(from: "2026-01-01T00:00:00Z")!
+
+    private var calendar: Calendar {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = utc
+        return calendar
+    }
+
+    private func date(hours: Double) -> Date {
+        start.addingTimeInterval(.hours(hours))
+    }
+
+    /// Glucose every 5 minutes for `hours`, using `value` to compute each reading from hours since start
+    private func glucose(hours: Double, value: (Double) -> Double) -> [TherapyInsightsInput.GlucoseReading] {
+        stride(from: 0.0, to: hours, by: 5.0 / 60).map { .init(date: date(hours: $0), mgdL: value($0)) }
+    }
+
+    private func input(days: Double = 1,
+                       glucose: [TherapyInsightsInput.GlucoseReading],
+                       doses: [DoseEntry] = [],
+                       carbs: [TherapyInsightsInput.CarbEntry] = []) -> TherapyInsightsInput {
+        var settings = TherapySettings()
+        settings.basalRateSchedule = BasalRateSchedule(dailyItems: [RepeatingScheduleValue(startTime: 0, value: 1.0)], timeZone: utc)
+        settings.insulinSensitivitySchedule = InsulinSensitivitySchedule(unit: .milligramsPerDeciliter, dailyItems: [RepeatingScheduleValue(startTime: 0, value: 40)], timeZone: utc)
+        settings.carbRatioSchedule = CarbRatioSchedule(unit: .gram(), dailyItems: [RepeatingScheduleValue(startTime: 0, value: 10)], timeZone: utc)
+        settings.suspendThreshold = GlucoseThreshold(unit: .millimolesPerLiter, value: 4.0)
+
+        return TherapyInsightsInput(
+            start: start,
+            end: start.addingTimeInterval(.days(days)),
+            glucose: glucose,
+            doses: doses,
+            carbs: carbs,
+            therapySettings: settings,
+            automaticDosingStrategy: .automaticBolus,
+            displayGlucoseUnit: .millimolesPerLiter,
+            algorithmExperiments: ["dampedMomentum": true],
+            calendar: calendar
+        )
+    }
+
+    func testGlucoseSummary() {
+        // 3 hours below 70, 21 hours at 120
+        let report = TherapyInsightsReport(input: input(glucose: glucose(hours: 24) { $0 < 3 ? 60 : 120 }))
+
+        let summary = try! XCTUnwrap(report.glucose)
+        XCTAssertEqual(summary.readings, 288)
+        XCTAssertEqual(summary.percentBelow70, 12.5)
+        XCTAssertEqual(summary.percentInRange70To180, 87.5)
+        XCTAssertEqual(summary.percentBelow54, 0)
+        XCTAssertEqual(summary.hypoglycemiaEvents, 1)
+        XCTAssertEqual(summary.meanMgdL, 113)
+        XCTAssertEqual(report.period.cgmCoveragePercent, 100)
+    }
+
+    func testShortLowIsNotAHypoglycemiaEvent() {
+        // Three readings (10 minutes) below 70
+        let report = TherapyInsightsReport(input: input(glucose: glucose(hours: 24) { $0 >= 1 && $0 < 1.2 ? 65 : 110 }))
+        XCTAssertEqual(report.glucose?.hypoglycemiaEvents, 0)
+    }
+
+    func testDeliveredBasalUsesTempBasalsAndSuspends() {
+        let doses = [
+            DoseEntry(type: .tempBasal, startDate: date(hours: 2), endDate: date(hours: 3), value: 2.0, unit: .unitsPerHour),
+            DoseEntry(type: .suspend, startDate: date(hours: 5), endDate: date(hours: 6), value: 0, unit: .units),
+            DoseEntry(type: .bolus, startDate: date(hours: 8), endDate: date(hours: 8), value: 0.3, unit: .units, deliveredUnits: 0.3, automatic: true),
+            DoseEntry(type: .bolus, startDate: date(hours: 12), endDate: date(hours: 12), value: 4, unit: .units, deliveredUnits: 4, automatic: false)
+        ]
+        let report = TherapyInsightsReport(input: input(glucose: glucose(hours: 24) { _ in 110 }, doses: doses))
+
+        XCTAssertEqual(report.hourly[1].deliveredBasalUnitsPerHour, 1.0)
+        XCTAssertEqual(report.hourly[2].deliveredBasalUnitsPerHour, 2.0)
+        XCTAssertEqual(report.hourly[2].scheduledBasalUnitsPerHour, 1.0)
+        XCTAssertEqual(report.hourly[5].deliveredBasalUnitsPerHour, 0)
+        XCTAssertEqual(report.hourly[8].automaticBolusUnitsPerHour, 0.3)
+
+        XCTAssertEqual(report.insulin.averageDailyScheduledBasal, 24)
+        XCTAssertEqual(report.insulin.averageDailyDeliveredBasal, 24)  // +1 U temp basal, -1 U suspend
+        XCTAssertEqual(report.insulin.averageDailyAutomaticBolus, 0.3)
+        XCTAssertEqual(report.insulin.averageDailyManualBolus, 4)
+        XCTAssertEqual(report.insulin.averageTotalDailyDose, 28.3)
+    }
+
+    func testCorrectionSensitivity() {
+        // 2 U correction at 200 mg/dL, 100 mg/dL four hours later: 50 mg/dL/U observed vs 40 scheduled
+        let bolus = DoseEntry(type: .bolus, startDate: date(hours: 10), endDate: date(hours: 10), value: 2, unit: .units, deliveredUnits: 2, automatic: false)
+        let readings = glucose(hours: 24) { hours in
+            switch hours {
+            case ..<10: return 200
+            case ..<14: return 200 - (hours - 10) * 25
+            default: return 100
+            }
+        }
+        let report = TherapyInsightsReport(input: input(glucose: readings, doses: [bolus]))
+
+        XCTAssertEqual(report.corrections.episodes, 1)
+        XCTAssertEqual(report.corrections.medianObservedSensitivityMgdLPerUnit, 50)
+        XCTAssertEqual(report.corrections.medianScheduledSensitivityMgdLPerUnit, 40)
+    }
+
+    func testCorrectionWithCarbsIsExcluded() {
+        let bolus = DoseEntry(type: .bolus, startDate: date(hours: 10), endDate: date(hours: 10), value: 2, unit: .units, deliveredUnits: 2, automatic: false)
+        let report = TherapyInsightsReport(input: input(glucose: glucose(hours: 24) { _ in 200 }, doses: [bolus], carbs: [.init(date: date(hours: 11), grams: 20)]))
+        XCTAssertEqual(report.corrections.episodes, 0)
+    }
+
+    func testMealExcursions() {
+        let readings = glucose(hours: 24) { hours in
+            switch hours {
+            case 8..<9: return 100 + (hours - 8) * 80   // peaks at 180
+            case 9..<11: return 180 - (hours - 9) * 20  // 140 at 11:00
+            case 11...: return 140
+            default: return 100
+            }
+        }
+        let carbs: [TherapyInsightsInput.CarbEntry] = [.init(date: date(hours: 8), grams: 40), .init(date: date(hours: 8.25), grams: 10)]
+        let report = TherapyInsightsReport(input: input(glucose: readings, carbs: carbs))
+
+        XCTAssertEqual(report.meals.count, 1)
+        let breakfast = report.meals[0]
+        XCTAssertEqual(breakfast.name, "breakfast (04-10)")
+        XCTAssertEqual(breakfast.meals, 1)
+        XCTAssertEqual(breakfast.medianCarbsGrams, 50)
+        XCTAssertEqual(breakfast.medianScheduledCarbRatio, 10)
+        XCTAssertEqual(breakfast.medianStartMgdL, 100)
+        XCTAssertEqual(breakfast.medianChangeAfter3hMgdL, 40)
+        XCTAssertEqual(breakfast.percentFollowedByLowWithin4h, 0)
+        XCTAssertEqual(try XCTUnwrap(breakfast.medianPeakRiseMgdL), 80, accuracy: 2)
+    }
+
+    func testOvernightDrift() {
+        // Two days; the second night (day 2, 00:00-06:00) rises 30 mg/dL with no carbs
+        let readings = glucose(hours: 48) { hours in
+            hours < 24 ? 100 : 100 + min(hours - 24, 6) * 5
+        }
+        let report = TherapyInsightsReport(input: input(days: 2, glucose: readings))
+
+        // The first night has no evening data before it, so only the second night qualifies
+        XCTAssertEqual(report.overnight.nights, 1)
+        XCTAssertEqual(report.overnight.medianDriftMgdL, 30)
+        XCTAssertEqual(report.overnight.medianDeliveredToScheduledBasalPercent, 100)
+    }
+
+    func testSettingsAreExportedInMgdL() throws {
+        let report = TherapyInsightsReport(input: input(glucose: []))
+
+        XCTAssertNil(report.glucose)
+        XCTAssertEqual(report.settings.displayGlucoseUnit, "mmol/L")
+        XCTAssertEqual(report.settings.basalRateUnitsPerHour, [.init(start: "00:00", value: 1.0)])
+        XCTAssertEqual(report.settings.insulinSensitivityMgdLPerUnit, [.init(start: "00:00", value: 40)])
+        XCTAssertEqual(report.settings.carbRatioGramsPerUnit, [.init(start: "00:00", value: 10)])
+        XCTAssertEqual(report.settings.suspendThresholdMgdL, 72)
+        XCTAssertEqual(report.settings.dosingStrategy, "automaticBolus")
+        XCTAssertTrue(try report.jsonString().contains("\"dampedMomentum\" : true"))
+    }
+}
+
+class TherapyInsightsAIClientTests: XCTestCase {
+    private func body(_ request: URLRequest) throws -> [String: Any] {
+        try XCTUnwrap(JSONSerialization.jsonObject(with: XCTUnwrap(request.httpBody)) as? [String: Any])
+    }
+
+    func testClaudeRequest() throws {
+        let request = try TherapyInsightsAIClient.makeRequest(provider: .claude, model: "claude-opus-5-5", apiKey: " sk-ant-test \n", system: "system", prompt: "prompt")
+
+        XCTAssertEqual(request.url?.absoluteString, "https://api.anthropic.com/v1/messages")
+        XCTAssertEqual(request.value(forHTTPHeaderField: "x-api-key"), "sk-ant-test")
+        XCTAssertEqual(request.value(forHTTPHeaderField: "anthropic-version"), "2023-06-01")
+        XCTAssertEqual(request.value(forHTTPHeaderField: "anthropic-beta"), "server-side-fallback-2026-07-01")
+        let body = try body(request)
+        XCTAssertEqual(body["model"] as? String, "claude-opus-5-5")
+        XCTAssertEqual(body["system"] as? String, "system")
+        XCTAssertEqual(body["fallbacks"] as? String, "default")
+        XCTAssertEqual((body["output_config"] as? [String: String])?["effort"], "high")
+    }
+
+    func testOlderClaudeModelOmitsEffortAndFallbacks() throws {
+        let request = try TherapyInsightsAIClient.makeRequest(provider: .claude, model: "claude-haiku-4-5", apiKey: "key", system: "s", prompt: "p")
+        let body = try body(request)
+        XCTAssertNil(body["output_config"])
+        XCTAssertNil(body["fallbacks"])
+        XCTAssertNil(request.value(forHTTPHeaderField: "anthropic-beta"))
+    }
+
+    func testChatCompletionsRequests() throws {
+        let deepSeek = try TherapyInsightsAIClient.makeRequest(provider: .deepSeek, model: "deepseek-chat", apiKey: "sk-1", system: "s", prompt: "p")
+        XCTAssertEqual(deepSeek.value(forHTTPHeaderField: "Authorization"), "Bearer sk-1")
+        let messages = try XCTUnwrap(body(deepSeek)["messages"] as? [[String: String]])
+        XCTAssertEqual(messages.map { $0["role"] }, ["system", "user"])
+
+        let gitHub = try TherapyInsightsAIClient.makeRequest(provider: .gitHubModels, model: "openai/gpt-4.1", apiKey: "github_pat_1", system: "s", prompt: "p")
+        XCTAssertEqual(gitHub.url?.host, "models.github.ai")
+        XCTAssertEqual(gitHub.value(forHTTPHeaderField: "Authorization"), "Bearer github_pat_1")
+    }
+
+    func testMissingAPIKey() {
+        XCTAssertThrowsError(try TherapyInsightsAIClient.makeRequest(provider: .claude, model: "m", apiKey: "  ", system: "s", prompt: "p")) { error in
+            XCTAssertEqual(error as? TherapyInsightsAIError, .missingAPIKey)
+        }
+    }
+
+    func testParseClaudeResponseSkipsThinkingBlocks() throws {
+        let json = #"{"content":[{"type":"thinking","thinking":""},{"type":"text","text":"## Summary"},{"type":"text","text":"\nAll good"}],"stop_reason":"end_turn"}"#
+        XCTAssertEqual(try TherapyInsightsAIClient.parseResponse(provider: .claude, data: Data(json.utf8)), "## Summary\nAll good")
+    }
+
+    func testParseClaudeRefusal() {
+        let json = #"{"content":[],"stop_reason":"refusal"}"#
+        XCTAssertThrowsError(try TherapyInsightsAIClient.parseResponse(provider: .claude, data: Data(json.utf8))) { error in
+            XCTAssertEqual(error as? TherapyInsightsAIError, .refused)
+        }
+    }
+
+    func testParseChatCompletionsResponse() throws {
+        let json = #"{"choices":[{"message":{"role":"assistant","content":"Hello"}}]}"#
+        XCTAssertEqual(try TherapyInsightsAIClient.parseResponse(provider: .deepSeek, data: Data(json.utf8)), "Hello")
+        XCTAssertThrowsError(try TherapyInsightsAIClient.parseResponse(provider: .gitHubModels, data: Data(#"{"choices":[]}"#.utf8)))
+    }
+}
