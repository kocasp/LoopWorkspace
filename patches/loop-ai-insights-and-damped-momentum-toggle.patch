+//
+//  TherapyInsightsView.swift
+//  Loop
+//
+//  Copyright © 2026 LoopKit Authors. All rights reserved.
+//
+
+import SwiftUI
+import LoopKitUI
+
+struct TherapyInsightsView: View {
+    @StateObject private var viewModel: TherapyInsightsViewModel
+    @FocusState private var isAPIKeyFocused: Bool
+
+    init(dataSource: TherapyInsightsDataSource) {
+        _viewModel = StateObject(wrappedValue: TherapyInsightsViewModel(dataSource: dataSource))
+    }
+
+    var body: some View {
+        Form {
+            disclaimerSection
+            providerSection
+            analysisSection
+            if let result = viewModel.result {
+                resultSection(result)
+            }
+        }
+        .navigationTitle(NSLocalizedString("AI Therapy Insights", comment: "Title of the AI therapy insights screen"))
+        .navigationBarTitleDisplayMode(.inline)
+        .onDisappear { viewModel.cancel() }
+    }
+
+    private var disclaimerSection: some View {
+        Section {
+            Label {
+                Text(NSLocalizedString("An AI model reviews your glucose, insulin and carb history together with your therapy settings and suggests adjustments. Suggestions can be wrong. Nothing is changed automatically — review any change with your diabetes care team before applying it in Therapy Settings.", comment: "AI therapy insights disclaimer"))
+                    .font(.footnote)
+            } icon: {
+                Image(systemName: "exclamationmark.triangle.fill")
+                    .foregroundColor(.orange)
+            }
+        }
+    }
+
+    private var providerSection: some View {
+        Section(
+            header: Text(NSLocalizedString("AI Provider", comment: "Section header for AI provider settings")),
+            footer: Text(viewModel.provider.apiKeyInstructions)
+        ) {
+            Picker(NSLocalizedString("Provider", comment: "Label for AI provider picker"), selection: $viewModel.provider) {
+                ForEach(TherapyInsightsProvider.allCases) { provider in
+                    Text(provider.displayName).tag(provider)
+                }
+            }
+
+            HStack {
+                Text(NSLocalizedString("Model", comment: "Label for AI model field"))
+                TextField(viewModel.provider.defaultModel, text: $viewModel.model)
+                    .multilineTextAlignment(.trailing)
+                    .disableAutocorrection(true)
+                    .textInputAutocapitalization(.never)
+                    .foregroundColor(.secondary)
+                if viewModel.model != viewModel.provider.defaultModel {
+                    Button(action: viewModel.resetModel) {
+                        Image(systemName: "arrow.uturn.backward.circle")
+                    }
+                    .buttonStyle(.borderless)
+                }
+            }
+
+            HStack {
+                SecureField(viewModel.provider.apiKeyPlaceholder, text: $viewModel.apiKey)
+                    .disableAutocorrection(true)
+                    .textInputAutocapitalization(.never)
+                    .focused($isAPIKeyFocused)
+                    .onSubmit(viewModel.saveAPIKey)
+                if viewModel.isAPIKeySaved {
+                    Image(systemName: "checkmark.seal.fill")
+                        .foregroundColor(.green)
+                        .accessibilityLabel(NSLocalizedString("API key saved", comment: "Accessibility label for saved API key"))
+                } else {
+                    Button(NSLocalizedString("Save", comment: "Button to save API key")) {
+                        isAPIKeyFocused = false
+                        viewModel.saveAPIKey()
+                    }
+                    .buttonStyle(.borderless)
+                }
+            }
+        }
+    }
+
+    private var analysisSection: some View {
+        Section(
+            header: Text(NSLocalizedString("Analysis", comment: "Section header for AI analysis")),
+            footer: Text(String(format: NSLocalizedString("Sends a summary of the selected period (statistics by hour of day, meals, corrections, overnight trends and your therapy settings — no names or device identifiers) to %1$@ using your API key. The provider bills your account for each analysis.", comment: "Footer describing what data is shared (1: provider name)"), viewModel.provider.displayName))
+        ) {
+            Picker(NSLocalizedString("Period", comment: "Label for analysis period picker"), selection: $viewModel.days) {
+                ForEach(TherapyInsightsViewModel.dayOptions, id: \.self) { days in
+                    Text(String(format: NSLocalizedString("%d days", comment: "Analysis period option (1: number of days)"), days)).tag(days)
+                }
+            }
+
+            Toggle(NSLocalizedString("Allow sending my data to the AI provider", comment: "Consent toggle for sharing data with AI provider"), isOn: $viewModel.hasConsentedToDataSharing)
+
+            NavigationLink(NSLocalizedString("Preview data to be sent", comment: "Link to preview data sent to the AI provider")) {
+                TherapyInsightsDataPreview(viewModel: viewModel)
+            }
+
+            switch viewModel.state {
+            case .collectingData, .waitingForAI:
+                HStack {
+                    ProgressView()
+                    Text(viewModel.state == .collectingData
+                         ? NSLocalizedString("Summarizing your data…", comment: "Progress text while collecting data")
+                         : NSLocalizedString("Waiting for the AI analysis (this can take a few minutes)…", comment: "Progress text while waiting for AI"))
+                        .font(.footnote)
+                        .foregroundColor(.secondary)
+                    Spacer()
+                    Button(NSLocalizedString("Cancel", comment: "Button to cancel AI analysis"), action: viewModel.cancel)
+                        .buttonStyle(.borderless)
+                }
+            default:
+                Button(action: viewModel.analyze) {
+                    Label(NSLocalizedString("Analyze & Recommend", comment: "Button to start AI analysis"), systemImage: "sparkles")
+                }
+                .disabled(!viewModel.canAnalyze)
+            }
+
+            if case .failed(let message) = viewModel.state {
+                Text(message)
+                    .font(.footnote)
+                    .foregroundColor(.red)
+            }
+        }
+    }
+
+    private func resultSection(_ result: String) -> some View {
+        Section(
+            header: HStack {
+                Text(NSLocalizedString("Recommendations", comment: "Section header for AI recommendations"))
+                Spacer()
+                Button {
+                    UIPasteboard.general.string = result
+                } label: {
+                    Image(systemName: "doc.on.doc")
+                        .accessibilityLabel(NSLocalizedString("Copy recommendations", comment: "Accessibility label for button copying AI recommendations"))
+                }
+            },
+            footer: resultFooter
+        ) {
+            MarkdownText(markdown: result)
+                .textSelection(.enabled)
+                .padding(.vertical, 4)
+        }
+    }
+
+    @ViewBuilder
+    private var resultFooter: some View {
+        if let date = viewModel.resultDate {
+            Text([date.formatted(date: .abbreviated, time: .shortened), viewModel.resultProvider].compactMap { $0 }.joined(separator: " · "))
+        }
+    }
+}
+
+private struct TherapyInsightsDataPreview: View {
+    @ObservedObject var viewModel: TherapyInsightsViewModel
+
+    var body: some View {
+        ScrollView {
+            if let preview = viewModel.dataPreview {
+                Text(preview)
+                    .font(.system(.caption, design: .monospaced))
+                    .textSelection(.enabled)
+                    .frame(maxWidth: .infinity, alignment: .leading)
+                    .padding()
+            } else {
+                ProgressView().padding()
+            }
+        }
+        .navigationTitle(NSLocalizedString("Data to be sent", comment: "Title of AI data preview screen"))
+        .navigationBarTitleDisplayMode(.inline)
+        .task { await viewModel.loadDataPreview() }
+    }
+}
+
+/// Renders the block-level Markdown typically returned by language models (headings, bullet lists, paragraphs)
+private struct MarkdownText: View {
+    let markdown: String
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 6) {
+            ForEach(Array(markdown.components(separatedBy: .newlines).enumerated()), id: \.offset) { _, line in
+                row(for: line)
+            }
+        }
+    }
+
+    @ViewBuilder
+    private func row(for line: String) -> some View {
+        let trimmed = line.trimmingCharacters(in: .whitespaces)
+        if trimmed.isEmpty {
+            EmptyView()
+        } else if let heading = trimmed.dropPrefix(while: "#") {
+            inline(heading)
+                .font(.headline)
+                .padding(.top, 6)
+        } else if let item = trimmed.dropPrefix("- ") ?? trimmed.dropPrefix("* ") {
+            HStack(alignment: .firstTextBaseline, spacing: 6) {
+                Text("•")
+                inline(item)
+            }
+            .padding(.leading, line.prefix(while: { $0 == " " }).count >= 2 ? 16 : 0)
+        } else if trimmed.allSatisfy({ $0 == "-" || $0 == "*" || $0 == "_" }) {
+            Divider()
+        } else {
+            inline(trimmed)
+        }
+    }
+
+    private func inline(_ text: String) -> Text {
+        if let attributed = try? AttributedString(markdown: text, options: .init(interpretedSyntax: .inlineOnlyPreservingWhitespace)) {
+            return Text(attributed)
+        }
+        return Text(text)
+    }
+}
+
+private extension String {
+    func dropPrefix(_ prefix: String) -> String? {
+        hasPrefix(prefix) ? String(dropFirst(prefix.count)) : nil
+    }
+
+    /// Strips a run of `character` followed by a space (e.g. Markdown heading markers)
+    func dropPrefix(while character: Character) -> String? {
+        let markers = prefix(while: { $0 == character })
+        guard !markers.isEmpty, dropFirst(markers.count).first == " " else {
+            return nil
+        }
+        return String(dropFirst(markers.count + 1))
+    }
+}
