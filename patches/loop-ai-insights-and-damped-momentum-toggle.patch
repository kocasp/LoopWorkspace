index 0000000..2e35a71
--- /dev/null
+++ b/Loop/Loop/Managers/Therapy Insights/TherapyInsightsReport.swift	
@@ -0,0 +1,623 @@
+//
+//  TherapyInsightsReport.swift
+//  Loop
+//
+//  Copyright © 2026 LoopKit Authors. All rights reserved.
+//
+
+import Foundation
+import HealthKit
+import LoopKit
+
+/// Raw history the therapy insights report is computed from
+struct TherapyInsightsInput {
+    struct GlucoseReading: Equatable {
+        let date: Date
+        let mgdL: Double
+    }
+
+    struct CarbEntry: Equatable {
+        let date: Date
+        let grams: Double
+    }
+
+    var start: Date
+    var end: Date
+    var glucose: [GlucoseReading]
+    var doses: [DoseEntry]
+    var carbs: [CarbEntry]
+    var therapySettings: TherapySettings
+    var automaticDosingStrategy: AutomaticDosingStrategy?
+    var displayGlucoseUnit: HKUnit
+    var algorithmExperiments: [String: Bool]
+    var calendar: Calendar = .current
+
+    var displayGlucoseUnitName: String {
+        displayGlucoseUnit == .millimolesPerLiter ? "mmol/L" : "mg/dL"
+    }
+}
+
+/// A compact, de-identified summary of glucose, insulin and carb history, used as the input for AI analysis.
+///
+/// All glucose values are in mg/dL, insulin in U, carbs in g.
+struct TherapyInsightsReport: Codable, Equatable {
+    struct Period: Codable, Equatable {
+        var start: Date
+        var end: Date
+        var days: Double
+        var cgmCoveragePercent: Double
+    }
+
+    struct GlucoseSummary: Codable, Equatable {
+        var readings: Int
+        var meanMgdL: Double
+        var standardDeviationMgdL: Double
+        var coefficientOfVariationPercent: Double
+        var glucoseManagementIndicatorPercent: Double
+        var percentBelow54: Double
+        var percentBelow70: Double
+        var percentInRange70To180: Double
+        var percentAbove180: Double
+        var percentAbove250: Double
+        /// Runs of at least 15 minutes below 70 mg/dL
+        var hypoglycemiaEvents: Int
+    }
+
+    struct HourlyProfile: Codable, Equatable {
+        var hour: Int
+        var medianMgdL: Double?
+        var p10MgdL: Double?
+        var p90MgdL: Double?
+        var percentBelow70: Double?
+        var percentAbove180: Double?
+        var scheduledBasalUnitsPerHour: Double?
+        /// Basal actually delivered, including Loop temp basals and suspensions
+        var deliveredBasalUnitsPerHour: Double?
+        var automaticBolusUnitsPerHour: Double?
+    }
+
+    struct InsulinSummary: Codable, Equatable {
+        var averageTotalDailyDose: Double
+        var averageDailyDeliveredBasal: Double
+        var averageDailyScheduledBasal: Double
+        var averageDailyManualBolus: Double
+        var averageDailyAutomaticBolus: Double
+        var averageDailyCarbsGrams: Double
+    }
+
+    struct MealBlock: Codable, Equatable {
+        var name: String
+        var meals: Int
+        var medianCarbsGrams: Double?
+        var medianScheduledCarbRatio: Double?
+        var medianStartMgdL: Double?
+        var medianPeakRiseMgdL: Double?
+        var medianChangeAfter3hMgdL: Double?
+        var percentFollowedByLowWithin4h: Double?
+    }
+
+    struct CorrectionSummary: Codable, Equatable {
+        /// Manual boluses ≥ 0.5 U, glucose ≥ 150 mg/dL, no carbs from 1 h before to 4 h after
+        var episodes: Int
+        /// Glucose drop over 4 h divided by net insulin (boluses + basal above schedule) in that window
+        var medianObservedSensitivityMgdLPerUnit: Double?
+        var medianScheduledSensitivityMgdLPerUnit: Double?
+    }
+
+    struct OvernightSummary: Codable, Equatable {
+        /// Nights without carbs or manual boluses from 21:00 to 06:00
+        var nights: Int
+        /// Glucose at 06:00 minus glucose at 00:00
+        var medianDriftMgdL: Double?
+        /// Insulin delivered by Loop (basal + automatic boluses) relative to scheduled basal, 00:00–06:00
+        var medianDeliveredToScheduledBasalPercent: Double?
+    }
+
+    struct ScheduleEntry: Codable, Equatable {
+        var start: String
+        var value: Double
+    }
+
+    struct RangeEntry: Codable, Equatable {
+        var start: String
+        var minimum: Double
+        var maximum: Double
+    }
+
+    struct Settings: Codable, Equatable {
+        var displayGlucoseUnit: String
+        var basalRateUnitsPerHour: [ScheduleEntry]
+        var insulinSensitivityMgdLPerUnit: [ScheduleEntry]
+        var carbRatioGramsPerUnit: [ScheduleEntry]
+        var correctionRangeMgdL: [RangeEntry]
+        var suspendThresholdMgdL: Double?
+        var maximumBasalRateUnitsPerHour: Double?
+        var maximumBolusUnits: Double?
+        var insulinModel: String?
+        var dosingStrategy: String?
+        var algorithmExperiments: [String: Bool]
+    }
+
+    var period: Period
+    var glucose: GlucoseSummary?
+    var hourly: [HourlyProfile]
+    var insulin: InsulinSummary
+    var meals: [MealBlock]
+    var corrections: CorrectionSummary
+    var overnight: OvernightSummary
+    var settings: Settings
+}
+
+extension TherapyInsightsReport {
+    func jsonString() throws -> String {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        encoder.dateEncodingStrategy = .iso8601
+        return String(decoding: try encoder.encode(self), as: UTF8.self)
+    }
+}
+
+// MARK: - Computation
+
+extension TherapyInsightsReport {
+    private static let slot: TimeInterval = .minutes(5)
+
+    init(input: TherapyInsightsInput) {
+        let builder = Builder(input: input)
+
+        self.init(
+            period: builder.period(),
+            glucose: builder.glucoseSummary(),
+            hourly: builder.hourlyProfiles(),
+            insulin: builder.insulinSummary(),
+            meals: builder.mealBlocks(),
+            corrections: builder.correctionSummary(),
+            overnight: builder.overnightSummary(),
+            settings: builder.settings()
+        )
+    }
+
+    /// Precomputes 5-minute timelines shared by the individual summaries
+    private struct Builder {
+        let input: TherapyInsightsInput
+        let glucose: [TherapyInsightsInput.GlucoseReading]
+        let boluses: [DoseEntry]
+        let carbs: [TherapyInsightsInput.CarbEntry]
+        let slotStarts: [Date]
+        let scheduledBasal: [Double?]
+        let deliveredBasal: [Double?]
+        var calendar: Calendar { input.calendar }
+        var days: Double { max(input.end.timeIntervalSince(input.start) / .days(1), 1.0 / 24) }
+
+        init(input: TherapyInsightsInput) {
+            self.input = input
+            glucose = input.glucose.filter { $0.date >= input.start && $0.date <= input.end }.sorted { $0.date < $1.date }
+            boluses = input.doses.filter { $0.type == .bolus && $0.startDate >= input.start && $0.startDate <= input.end }.sorted { $0.startDate < $1.startDate }
+            carbs = input.carbs.filter { $0.date >= input.start && $0.date <= input.end }.sorted { $0.date < $1.date }
+
+            var slotStarts: [Date] = []
+            var date = input.start
+            while date < input.end {
+                slotStarts.append(date)
+                date = date.addingTimeInterval(TherapyInsightsReport.slot)
+            }
+            self.slotStarts = slotStarts
+
+            let basalSchedule = input.therapySettings.basalRateSchedule
+            scheduledBasal = slotStarts.map { basalSchedule?.value(at: $0.addingTimeInterval(TherapyInsightsReport.slot / 2)) }
+            deliveredBasal = Builder.deliveredBasalRates(slotStarts: slotStarts, doses: input.doses, scheduled: scheduledBasal)
+        }
+
+        /// The basal rate in effect at the middle of each slot: the most recently started basal-type dose covering it, otherwise the scheduled rate.
+        private static func deliveredBasalRates(slotStarts: [Date], doses: [DoseEntry], scheduled: [Double?]) -> [Double?] {
+            let basalDoses = doses.filter { [.basal, .tempBasal, .suspend].contains($0.type) && $0.endDate > $0.startDate }.sorted { $0.startDate < $1.startDate }
+            var nextIndex = 0
+            var active: [DoseEntry] = []
+
+            return slotStarts.enumerated().map { index, slotStart in
+                let midpoint = slotStart.addingTimeInterval(TherapyInsightsReport.slot / 2)
+                while nextIndex < basalDoses.count, basalDoses[nextIndex].startDate <= midpoint {
+                    active.append(basalDoses[nextIndex])
+                    nextIndex += 1
+                }
+                active.removeAll { $0.endDate <= midpoint }
+
+                guard let dose = active.last else {
+                    return scheduled[index]
+                }
+                if dose.type == .suspend {
+                    return 0
+                }
+                let hours = dose.endDate.timeIntervalSince(dose.startDate).hours
+                if let delivered = dose.deliveredUnits, hours > 0 {
+                    return delivered / hours
+                }
+                return dose.unitsPerHour
+            }
+        }
+
+        // MARK: Lookups
+
+        func glucose(near date: Date, tolerance: TimeInterval = .minutes(10)) -> Double? {
+            var low = 0
+            var high = glucose.count
+            while low < high {
+                let mid = (low + high) / 2
+                if glucose[mid].date < date {
+                    low = mid + 1
+                } else {
+                    high = mid
+                }
+            }
+            let candidates = [low - 1, low].filter { glucose.indices.contains($0) }
+            guard let best = candidates.min(by: { abs(glucose[$0].date.timeIntervalSince(date)) < abs(glucose[$1].date.timeIntervalSince(date)) }),
+                  abs(glucose[best].date.timeIntervalSince(date)) <= tolerance
+            else {
+                return nil
+            }
+            return glucose[best].mgdL
+        }
+
+        func glucose(from start: Date, to end: Date) -> [Double] {
+            glucose.filter { $0.date >= start && $0.date <= end }.map(\.mgdL)
+        }
+
+        func bolusUnits(_ dose: DoseEntry) -> Double {
+            dose.deliveredUnits ?? dose.programmedUnits
+        }
+
+        func isAutomatic(_ dose: DoseEntry) -> Bool {
+            dose.automatic == true
+        }
+
+        func carbs(from start: Date, to end: Date) -> [TherapyInsightsInput.CarbEntry] {
+            carbs.filter { $0.date >= start && $0.date <= end }
+        }
+
+        func manualBoluses(from start: Date, to end: Date) -> [DoseEntry] {
+            boluses.filter { !isAutomatic($0) && $0.startDate >= start && $0.startDate <= end }
+        }
+
+        func slotIndices(from start: Date, to end: Date) -> Range<Int> {
+            let lower = max(0, Int((start.timeIntervalSince(input.start) / TherapyInsightsReport.slot).rounded(.down)))
+            let upper = min(slotStarts.count, Int((end.timeIntervalSince(input.start) / TherapyInsightsReport.slot).rounded(.down)))
+            return lower..<max(lower, upper)
+        }
+
+        /// Units delivered as basal minus units scheduled, over the slots in the window
+        func basalDeviationUnits(from start: Date, to end: Date) -> Double? {
+            var total = 0.0
+            for index in slotIndices(from: start, to: end) {
+                guard let delivered = deliveredBasal[index], let scheduled = scheduledBasal[index] else {
+                    return nil
+                }
+                total += (delivered - scheduled) * TherapyInsightsReport.slot.hours
+            }
+            return total
+        }
+
+        // MARK: Summaries
+
+        func period() -> Period {
+            let expectedReadings = input.end.timeIntervalSince(input.start) / TherapyInsightsReport.slot
+            return Period(
+                start: input.start,
+                end: input.end,
+                days: days.rounded(to: 1),
+                cgmCoveragePercent: expectedReadings > 0 ? min(100, Double(glucose.count) / expectedReadings * 100).rounded(to: 1) : 0
+            )
+        }
+
+        func glucoseSummary() -> GlucoseSummary? {
+            let values = glucose.map(\.mgdL)
+            guard !values.isEmpty else {
+                return nil
+            }
+            let mean = values.reduce(0, +) / Double(values.count)
+            let variance = values.reduce(0) { $0 + pow($1 - mean, 2) } / Double(values.count)
+            let standardDeviation = variance.squareRoot()
+
+            return GlucoseSummary(
+                readings: values.count,
+                meanMgdL: mean.rounded(to: 0),
+                standardDeviationMgdL: standardDeviation.rounded(to: 0),
+                coefficientOfVariationPercent: (standardDeviation / mean * 100).rounded(to: 1),
+                glucoseManagementIndicatorPercent: (3.31 + 0.02392 * mean).rounded(to: 1),
+                percentBelow54: values.percent { $0 < 54 },
+                percentBelow70: values.percent { $0 < 70 },
+                percentInRange70To180: values.percent { $0 >= 70 && $0 <= 180 },
+                percentAbove180: values.percent { $0 > 180 },
+                percentAbove250: values.percent { $0 > 250 },
+                hypoglycemiaEvents: hypoglycemiaEvents()
+            )
+        }
+
+        func hypoglycemiaEvents() -> Int {
+            var events = 0
+            var runStart: Date?
+            var previous: Date?
+            var counted = false
+
+            for reading in glucose {
+                if let previousDate = previous, reading.date.timeIntervalSince(previousDate) > .minutes(15) {
+                    runStart = nil
+                }
+                if reading.mgdL < 70 {
+                    if runStart == nil {
+                        runStart = reading.date
+                        counted = false
+                    }
+                    if let start = runStart, !counted, reading.date.timeIntervalSince(start) >= .minutes(15) {
+                        events += 1
+                        counted = true
+                    }
+                } else {
+                    runStart = nil
+                }
+                previous = reading.date
+            }
+            return events
+        }
+
+        func hourlyProfiles() -> [HourlyProfile] {
+            var glucoseByHour = [[Double]](repeating: [], count: 24)
+            for reading in glucose {
+                glucoseByHour[calendar.component(.hour, from: reading.date)].append(reading.mgdL)
+            }
+
+            var scheduledByHour = [[Double]](repeating: [], count: 24)
+            var deliveredByHour = [[Double]](repeating: [], count: 24)
+            for (index, slotStart) in slotStarts.enumerated() {
+                let hour = calendar.component(.hour, from: slotStart)
+                if let scheduled = scheduledBasal[index] {
+                    scheduledByHour[hour].append(scheduled)
+                }
+                if let delivered = deliveredBasal[index] {
+                    deliveredByHour[hour].append(delivered)
+                }
+            }
+
+            var automaticBolusByHour = [Double](repeating: 0, count: 24)
+            for bolus in boluses where isAutomatic(bolus) {
+                automaticBolusByHour[calendar.component(.hour, from: bolus.startDate)] += bolusUnits(bolus)
+            }
+
+            return (0..<24).map { hour in
+                let values = glucoseByHour[hour].sorted()
+                return HourlyProfile(
+                    hour: hour,
+                    medianMgdL: values.percentile(0.5)?.rounded(to: 0),
+                    p10MgdL: values.percentile(0.1)?.rounded(to: 0),
+                    p90MgdL: values.percentile(0.9)?.rounded(to: 0),
+                    percentBelow70: values.isEmpty ? nil : values.percent { $0 < 70 },
+                    percentAbove180: values.isEmpty ? nil : values.percent { $0 > 180 },
+                    scheduledBasalUnitsPerHour: scheduledByHour[hour].mean?.rounded(to: 2),
+                    deliveredBasalUnitsPerHour: deliveredByHour[hour].mean?.rounded(to: 2),
+                    automaticBolusUnitsPerHour: (automaticBolusByHour[hour] / days).rounded(to: 2)
+                )
+            }
+        }
+
+        func insulinSummary() -> InsulinSummary {
+            let slotHours = TherapyInsightsReport.slot.hours
+            let delivered = deliveredBasal.compactMap { $0 }.reduce(0) { $0 + $1 * slotHours }
+            let scheduled = scheduledBasal.compactMap { $0 }.reduce(0) { $0 + $1 * slotHours }
+            let manual = boluses.filter { !isAutomatic($0) }.reduce(0) { $0 + bolusUnits($1) }
+            let automatic = boluses.filter { isAutomatic($0) }.reduce(0) { $0 + bolusUnits($1) }
+            let grams = carbs.reduce(0) { $0 + $1.grams }
+
+            return InsulinSummary(
+                averageTotalDailyDose: ((delivered + manual + automatic) / days).rounded(to: 1),
+                averageDailyDeliveredBasal: (delivered / days).rounded(to: 1),
+                averageDailyScheduledBasal: (scheduled / days).rounded(to: 1),
+                averageDailyManualBolus: (manual / days).rounded(to: 1),
+                averageDailyAutomaticBolus: (automatic / days).rounded(to: 1),
+                averageDailyCarbsGrams: (grams / days).rounded(to: 0)
+            )
+        }
+
+        static func mealBlockName(hour: Int) -> String {
+            switch hour {
+            case 4..<10: return "breakfast (04-10)"
+            case 10..<15: return "lunch (10-15)"
+            case 15..<21: return "dinner (15-21)"
+            default: return "late (21-04)"
+            }
+        }
+
+        func mealBlocks() -> [MealBlock] {
+            struct Meal {
+                var grams: Double
+                var carbRatio: Double?
+                var start: Double?
+                var peakRise: Double?
+                var changeAfter3h: Double?
+                var lowWithin4h: Bool
+            }
+
+            var mealsByBlock: [String: [Meal]] = [:]
+            var previousMealDate: Date?
+
+            for entry in carbs where entry.grams >= 10 {
+                defer { previousMealDate = entry.date }
+                // Entries shortly after another meal are treated as part of it
+                if let previous = previousMealDate, entry.date.timeIntervalSince(previous) < .hours(1) {
+                    continue
+                }
+                let grams = carbs(from: entry.date, to: entry.date.addingTimeInterval(.hours(1) - 1)).reduce(0) { $0 + $1.grams }
+                let start = glucose(near: entry.date)
+                let window = glucose(from: entry.date, to: entry.date.addingTimeInterval(.hours(3)))
+                let after3h = glucose(near: entry.date.addingTimeInterval(.hours(3)))
+                let lowWithin4h = glucose(from: entry.date, to: entry.date.addingTimeInterval(.hours(4))).contains { $0 < 70 }
+
+                let meal = Meal(
+                    grams: grams,
+                    carbRatio: input.therapySettings.carbRatioSchedule?.value(at: entry.date),
+                    start: start,
+                    peakRise: start.flatMap { start in window.max().map { $0 - start } },
+                    changeAfter3h: start.flatMap { start in after3h.map { $0 - start } },
+                    lowWithin4h: lowWithin4h
+                )
+                mealsByBlock[Builder.mealBlockName(hour: calendar.component(.hour, from: entry.date)), default: []].append(meal)
+            }
+
+            return ["breakfast (04-10)", "lunch (10-15)", "dinner (15-21)", "late (21-04)"].compactMap { name in
+                guard let meals = mealsByBlock[name], !meals.isEmpty else {
+                    return nil
+                }
+                return MealBlock(
+                    name: name,
+                    meals: meals.count,
+                    medianCarbsGrams: meals.map(\.grams).sorted().percentile(0.5)?.rounded(to: 0),
+                    medianScheduledCarbRatio: meals.compactMap(\.carbRatio).sorted().percentile(0.5)?.rounded(to: 1),
+                    medianStartMgdL: meals.compactMap(\.start).sorted().percentile(0.5)?.rounded(to: 0),
+                    medianPeakRiseMgdL: meals.compactMap(\.peakRise).sorted().percentile(0.5)?.rounded(to: 0),
+                    medianChangeAfter3hMgdL: meals.compactMap(\.changeAfter3h).sorted().percentile(0.5)?.rounded(to: 0),
+                    percentFollowedByLowWithin4h: meals.map(\.lowWithin4h).percent { $0 }
+                )
+            }
+        }
+
+        func correctionSummary() -> CorrectionSummary {
+            let window: TimeInterval = .hours(4)
+            var observed: [Double] = []
+            var scheduled: [Double] = []
+            let sensitivitySchedule = input.therapySettings.insulinSensitivitySchedule
+
+            for bolus in boluses where !isAutomatic(bolus) && bolusUnits(bolus) >= 0.5 {
+                let date = bolus.startDate
+                let end = date.addingTimeInterval(window)
+                guard end <= input.end,
+                      carbs(from: date.addingTimeInterval(.hours(-1)), to: end).isEmpty,
+                      let startGlucose = glucose(near: date), startGlucose >= 150,
+                      let endGlucose = glucose(near: end),
+                      let basalDeviation = basalDeviationUnits(from: date, to: end)
+                else {
+                    continue
+                }
+                let bolusTotal = boluses.filter { $0.startDate >= date && $0.startDate < end }.reduce(0) { $0 + bolusUnits($1) }
+                let netInsulin = bolusTotal + basalDeviation
+                guard netInsulin >= 0.5 else {
+                    continue
+                }
+                observed.append((startGlucose - endGlucose) / netInsulin)
+                if let schedule = sensitivitySchedule {
+                    scheduled.append(HKQuantity(unit: schedule.unit, doubleValue: schedule.value(at: date)).doubleValue(for: .milligramsPerDeciliter))
+                }
+            }
+
+            return CorrectionSummary(
+                episodes: observed.count,
+                medianObservedSensitivityMgdLPerUnit: observed.sorted().percentile(0.5)?.rounded(to: 0),
+                medianScheduledSensitivityMgdLPerUnit: scheduled.sorted().percentile(0.5)?.rounded(to: 0)
+            )
+        }
+
+        func overnightSummary() -> OvernightSummary {
+            var drifts: [Double] = []
+            var deliveredPercents: [Double] = []
+            var day = calendar.startOfDay(for: input.start)
+
+            while day < input.end {
+                defer { day = calendar.date(byAdding: .day, value: 1, to: day) ?? input.end }
+                guard let morning = calendar.date(byAdding: .hour, value: 6, to: day),
+                      morning <= input.end,
+                      let evening = calendar.date(byAdding: .hour, value: -3, to: day),
+                      evening >= input.start,
+                      carbs(from: evening, to: morning).isEmpty,
+                      manualBoluses(from: evening, to: morning).isEmpty,
+                      let midnightGlucose = glucose(near: day),
+                      let morningGlucose = glucose(near: morning)
+                else {
+                    continue
+                }
+                drifts.append(morningGlucose - midnightGlucose)
+
+                let indices = slotIndices(from: day, to: morning)
+                let scheduledUnits = indices.compactMap { scheduledBasal[$0] }.reduce(0) { $0 + $1 * TherapyInsightsReport.slot.hours }
+                let deliveredUnits = indices.compactMap { deliveredBasal[$0] }.reduce(0) { $0 + $1 * TherapyInsightsReport.slot.hours }
+                let automaticUnits = boluses.filter { isAutomatic($0) && $0.startDate >= day && $0.startDate < morning }.reduce(0) { $0 + bolusUnits($1) }
+                if scheduledUnits > 0 {
+                    deliveredPercents.append((deliveredUnits + automaticUnits) / scheduledUnits * 100)
+                }
+            }
+
+            return OvernightSummary(
+                nights: drifts.count,
+                medianDriftMgdL: drifts.sorted().percentile(0.5)?.rounded(to: 0),
+                medianDeliveredToScheduledBasalPercent: deliveredPercents.sorted().percentile(0.5)?.rounded(to: 0)
+            )
+        }
+
+        func settings() -> Settings {
+            let therapy = input.therapySettings
+            let mgdL = HKUnit.milligramsPerDeciliter
+
+            func timeString(_ startTime: TimeInterval) -> String {
+                let minutes = Int(startTime / 60)
+                return String(format: "%02d:%02d", minutes / 60, minutes % 60)
+            }
+
+            func convert(_ value: Double, from unit: HKUnit) -> Double {
+                HKQuantity(unit: unit, doubleValue: value).doubleValue(for: mgdL)
+            }
+
+            return Settings(
+                displayGlucoseUnit: input.displayGlucoseUnitName,
+                basalRateUnitsPerHour: therapy.basalRateSchedule?.items.map { ScheduleEntry(start: timeString($0.startTime), value: $0.value.rounded(to: 3)) } ?? [],
+                insulinSensitivityMgdLPerUnit: therapy.insulinSensitivitySchedule.map { schedule in
+                    schedule.items.map { ScheduleEntry(start: timeString($0.startTime), value: convert($0.value, from: schedule.unit).rounded(to: 1)) }
+                } ?? [],
+                carbRatioGramsPerUnit: therapy.carbRatioSchedule?.items.map { ScheduleEntry(start: timeString($0.startTime), value: $0.value.rounded(to: 1)) } ?? [],
+                correctionRangeMgdL: therapy.glucoseTargetRangeSchedule.map { schedule in
+                    schedule.items.map {
+                        RangeEntry(start: timeString($0.startTime),
+                                   minimum: convert($0.value.minValue, from: schedule.unit).rounded(to: 0),
+                                   maximum: convert($0.value.maxValue, from: schedule.unit).rounded(to: 0))
+                    }
+                } ?? [],
+                suspendThresholdMgdL: therapy.suspendThreshold?.quantity.doubleValue(for: mgdL).rounded(to: 0),
+                maximumBasalRateUnitsPerHour: therapy.maximumBasalRatePerHour,
+                maximumBolusUnits: therapy.maximumBolus,
+                insulinModel: therapy.defaultRapidActingModel?.rawValue,
+                dosingStrategy: input.automaticDosingStrategy.map { $0 == .automaticBolus ? "automaticBolus" : "tempBasalOnly" },
+                algorithmExperiments: input.algorithmExperiments
+            )
+        }
+    }
+}
+
+// MARK: - Helpers
+
+private extension Double {
+    func rounded(to places: Int) -> Double {
+        let multiplier = pow(10, Double(places))
+        return (self * multiplier).rounded() / multiplier
+    }
+}
+
+private extension Array where Element == Double {
+    var mean: Double? {
+        isEmpty ? nil : reduce(0, +) / Double(count)
+    }
+
+    /// Linearly interpolated percentile of a sorted array
+    func percentile(_ fraction: Double) -> Double? {
+        guard !isEmpty else {
+            return nil
+        }
+        let position = fraction * Double(count - 1)
+        let lower = Int(position.rounded(.down))
+        let upper = Swift.min(lower + 1, count - 1)
+        return self[lower] + (self[upper] - self[lower]) * (position - Double(lower))
+    }
+}
+
+private extension Array {
+    func percent(where predicate: (Element) -> Bool) -> Double {
+        guard !isEmpty else {
+            return 0
+        }
+        return (Double(filter(predicate).count) / Double(count) * 100).rounded(to: 1)
+    }
+}
