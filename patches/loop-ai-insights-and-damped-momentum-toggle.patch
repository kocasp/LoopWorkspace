diff --git a/Loop/Loop/View Models/TherapyInsightsViewModel.swift b/Loop/Loop/View Models/TherapyInsightsViewModel.swift
new file mode 100644
index 0000000..496e8d2
--- /dev/null
+++ b/Loop/Loop/View Models/TherapyInsightsViewModel.swift	
@@ -0,0 +1,183 @@
+//
+//  TherapyInsightsViewModel.swift
+//  Loop
+//
+//  Copyright © 2026 LoopKit Authors. All rights reserved.
+//
+
+import Foundation
+import LoopKit
+import os.log
+
+@MainActor
+final class TherapyInsightsViewModel: ObservableObject {
+    enum State: Equatable {
+        case idle
+        case collectingData
+        case waitingForAI
+        case failed(String)
+
+        var isBusy: Bool {
+            self == .collectingData || self == .waitingForAI
+        }
+    }
+
+    private enum Key {
+        static let provider = "com.loopkit.Loop.TherapyInsights.provider"
+        static let days = "com.loopkit.Loop.TherapyInsights.days"
+        static let consent = "com.loopkit.Loop.TherapyInsights.dataSharingConsent"
+        static let lastResult = "com.loopkit.Loop.TherapyInsights.lastResult"
+        static let lastResultDate = "com.loopkit.Loop.TherapyInsights.lastResultDate"
+        static let lastResultProvider = "com.loopkit.Loop.TherapyInsights.lastResultProvider"
+
+        static func model(_ provider: TherapyInsightsProvider) -> String {
+            "com.loopkit.Loop.TherapyInsights.model.\(provider.rawValue)"
+        }
+
+        static func apiKeyService(_ provider: TherapyInsightsProvider) -> String {
+            "com.loopkit.Loop.TherapyInsights.apiKey.\(provider.rawValue)"
+        }
+    }
+
+    static let dayOptions = [7, 14, 30]
+
+    @Published var provider: TherapyInsightsProvider {
+        didSet {
+            guard provider != oldValue else { return }
+            defaults.set(provider.rawValue, forKey: Key.provider)
+            model = defaults.string(forKey: Key.model(provider)) ?? provider.defaultModel
+            apiKey = (try? keychain.getGenericPasswordForService(Key.apiKeyService(provider))) ?? ""
+            isAPIKeySaved = !apiKey.isEmpty
+        }
+    }
+    @Published var model: String {
+        didSet { defaults.set(model, forKey: Key.model(provider)) }
+    }
+    @Published var apiKey: String {
+        didSet { isAPIKeySaved = false }
+    }
+    @Published private(set) var isAPIKeySaved: Bool
+    @Published var days: Int {
+        didSet { defaults.set(days, forKey: Key.days) }
+    }
+    @Published var hasConsentedToDataSharing: Bool {
+        didSet { defaults.set(hasConsentedToDataSharing, forKey: Key.consent) }
+    }
+    @Published private(set) var state: State = .idle
+    @Published private(set) var result: String?
+    @Published private(set) var resultDate: Date?
+    @Published private(set) var resultProvider: String?
+    @Published private(set) var dataPreview: String?
+
+    var canAnalyze: Bool {
+        !state.isBusy && hasConsentedToDataSharing && !apiKey.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty && !model.isEmpty
+    }
+
+    private let dataSource: TherapyInsightsDataSource
+    private let client: TherapyInsightsAIClient
+    private let keychain: KeychainManager
+    private let defaults: UserDefaults
+    private let log = OSLog(category: "TherapyInsightsViewModel")
+    private var analysisTask: Task<Void, Never>?
+
+    init(dataSource: TherapyInsightsDataSource, client: TherapyInsightsAIClient = TherapyInsightsAIClient(), keychain: KeychainManager = KeychainManager(), defaults: UserDefaults = .standard) {
+        self.dataSource = dataSource
+        self.client = client
+        self.keychain = keychain
+        self.defaults = defaults
+
+        let provider = defaults.string(forKey: Key.provider).flatMap(TherapyInsightsProvider.init(rawValue:)) ?? .claude
+        let apiKey = (try? keychain.getGenericPasswordForService(Key.apiKeyService(provider))) ?? ""
+        self.provider = provider
+        self.model = defaults.string(forKey: Key.model(provider)) ?? provider.defaultModel
+        self.apiKey = apiKey
+        self.isAPIKeySaved = !apiKey.isEmpty
+        let storedDays = defaults.integer(forKey: Key.days)
+        self.days = Self.dayOptions.contains(storedDays) ? storedDays : 14
+        self.hasConsentedToDataSharing = defaults.bool(forKey: Key.consent)
+        self.result = defaults.string(forKey: Key.lastResult)
+        self.resultDate = defaults.object(forKey: Key.lastResultDate) as? Date
+        self.resultProvider = defaults.string(forKey: Key.lastResultProvider)
+    }
+
+    func saveAPIKey() {
+        let trimmed = apiKey.trimmingCharacters(in: .whitespacesAndNewlines)
+        do {
+            try keychain.replaceGenericPassword(trimmed.isEmpty ? nil : trimmed, forService: Key.apiKeyService(provider))
+            apiKey = trimmed
+            isAPIKeySaved = !trimmed.isEmpty
+        } catch {
+            log.error("Failed to save API key: %{public}@", String(describing: error))
+            state = .failed(error.localizedDescription)
+        }
+    }
+
+    func resetModel() {
+        model = provider.defaultModel
+    }
+
+    func loadDataPreview() async {
+        do {
+            dataPreview = try await reportJSON()
+        } catch {
+            dataPreview = error.localizedDescription
+        }
+    }
+
+    func analyze() {
+        guard canAnalyze else { return }
+        if !isAPIKeySaved {
+            saveAPIKey()
+        }
+
+        analysisTask = Task {
+            do {
+                state = .collectingData
+                let json = try await reportJSON()
+
+                state = .waitingForAI
+                let prompt = TherapyInsightsPrompt.user(reportJSON: json, displayGlucoseUnit: displayUnitName, language: Self.preferredLanguage)
+                let text = try await client.recommendations(provider: provider, model: model, apiKey: apiKey, system: TherapyInsightsPrompt.system, prompt: prompt)
+                try Task.checkCancellation()
+
+                storeResult(text)
+                state = .idle
+            } catch is CancellationError {
+                state = .idle
+            } catch let error as URLError where error.code == .cancelled {
+                state = .idle
+            } catch {
+                log.error("Therapy insights analysis failed: %{public}@", String(describing: error))
+                state = .failed(error.localizedDescription)
+            }
+        }
+    }
+
+    func cancel() {
+        analysisTask?.cancel()
+        analysisTask = nil
+    }
+
+    private var displayUnitName = "mg/dL"
+
+    private func reportJSON() async throws -> String {
+        let input = try await dataSource.therapyInsightsInput(days: days)
+        displayUnitName = input.displayGlucoseUnitName
+        return try TherapyInsightsReport(input: input).jsonString()
+    }
+
+    private func storeResult(_ text: String) {
+        let date = Date()
+        result = text
+        resultDate = date
+        resultProvider = "\(provider.displayName) · \(model)"
+        defaults.set(text, forKey: Key.lastResult)
+        defaults.set(date, forKey: Key.lastResultDate)
+        defaults.set(resultProvider, forKey: Key.lastResultProvider)
+    }
+
+    private static var preferredLanguage: String {
+        let identifier = Locale.preferredLanguages.first ?? "en"
+        return Locale(identifier: "en").localizedString(forIdentifier: identifier) ?? identifier
+    }
+}
