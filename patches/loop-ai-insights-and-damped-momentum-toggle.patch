+//
+//  TherapyInsightsDataSource.swift
+//  Loop
+//
+//  Copyright © 2026 LoopKit Authors. All rights reserved.
+//
+
+import Foundation
+import HealthKit
+import LoopKit
+
+protocol TherapyInsightsDataSource: AnyObject {
+    func therapyInsightsInput(days: Int) async throws -> TherapyInsightsInput
+}
+
+extension DeviceDataManager: TherapyInsightsDataSource {
+    func therapyInsightsInput(days: Int) async throws -> TherapyInsightsInput {
+        let end = Date()
+        let start = end.addingTimeInterval(-.days(Double(days)))
+
+        async let glucoseSamples = glucoseStore.getGlucoseSamples(start: start, end: end)
+        async let doses = doseStore.getDoses(start: start, end: end)
+        async let carbEntries = carbStore.getCarbEntries(start: start, end: end)
+
+        let (therapySettings, dosingStrategy, displayUnit) = await MainActor.run {
+            (loopManager.therapySettings, loopManager.settings.automaticDosingStrategy, displayGlucosePreference.unit)
+        }
+
+        return TherapyInsightsInput(
+            start: start,
+            end: end,
+            glucose: try await glucoseSamples
+                .filter { !$0.isDisplayOnly }
+                .map { .init(date: $0.startDate, mgdL: $0.quantity.doubleValue(for: .milligramsPerDeciliter)) },
+            doses: try await doses,
+            carbs: try await carbEntries.map { .init(date: $0.startDate, grams: $0.quantity.doubleValue(for: .gram())) },
+            therapySettings: therapySettings,
+            automaticDosingStrategy: dosingStrategy,
+            displayGlucoseUnit: displayUnit,
+            algorithmExperiments: [
+                "integralRetrospectiveCorrection": UserDefaults.standard.integralRetrospectiveCorrectionEnabled,
+                "glucoseBasedPartialApplication": UserDefaults.standard.glucoseBasedApplicationFactorEnabled,
+                "dampedMomentum": GlucoseMath.isDampedMomentumEnabled
+            ]
+        )
+    }
+}
diff --git a/Loop/Loop/Managers/Therapy Insights/TherapyInsightsReport.swift b/Loop/Loop/Managers/Therapy Insights/TherapyInsightsReport.swift
