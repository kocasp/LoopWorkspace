+//
+//  DampedMomentumSelectionView.swift
+//  Loop
+//
+//  Copyright © 2026 LoopKit Authors. All rights reserved.
+//
+
+import SwiftUI
+import LoopKit
+
+public struct DampedMomentumSelectionView: View {
+    @Binding var isDampedMomentumEnabled: Bool
+
+    public var body: some View {
+        ScrollView {
+            VStack(spacing: 10) {
+                Text(NSLocalizedString("Damped Momentum", comment: "Title for damped momentum experiment description"))
+                    .font(.headline)
+                    .padding(.bottom, 20)
+
+                Divider()
+
+                Text(NSLocalizedString("Momentum is the part of the forecast based on the most recent glucose trend. Standard Loop projects the last 15 minutes of trend linearly for 15 minutes.\n\nWith Damped Momentum, a steady trend is projected for 30 minutes with gradually decreasing speed, so Loop reacts a little earlier to sustained rises and falls. Noisy or turning trends (sensor noise, recovery from a compression low, the peak of a meal) use the standard projection.\n\nThe effect is modest: for a steady unexplained trend the forecast moves about a third further than standard. Changes take effect with the next glucose reading.", comment: "Description of Damped Momentum toggle."))
+                    .foregroundColor(.secondary)
+                Divider()
+
+                Toggle(NSLocalizedString("Enable Damped Momentum", comment: "Title for Damped Momentum toggle"), isOn: $isDampedMomentumEnabled)
+                    .padding(.top, 20)
+            }
+            .padding()
+        }
+        .navigationBarTitleDisplayMode(.inline)
+    }
+}
+
+struct DampedMomentumSelectionView_Previews: PreviewProvider {
+    static var previews: some View {
+        DampedMomentumSelectionView(isDampedMomentumEnabled: .constant(true))
+    }
+}
