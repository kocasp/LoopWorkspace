+    /// Calculates the short-term predicted momentum effect using a damped trend projection.
+    ///
+    /// The trend is projected for `duration` with exponentially decaying velocity, instead of linearly for 15 minutes.
+    /// Note that `LoopMath.predictGlucose` blends momentum out linearly over the length of the momentum timeline,
+    /// so the net added effect is modest: for an unexplained trend it is roughly equivalent to a 20 minute linear
+    /// projection, and while blending it also down-weights the insulin and carb effects for 30 minutes instead of 15.
+    ///
+    /// The trend is only extended when it is consistent: the regression must fit the samples well
+    /// (R² ≥ `minimumFitQuality`) and the most recent change must agree with its direction. Otherwise
+    /// (sensor noise, compression-low recovery, turning points) this returns `linearMomentumEffect`.
+    ///
+    /// - Parameters:
+    ///   - duration: The duration of the projected effect
+    ///   - delta: The time differential for the returned values
+    ///   - dampingTimeConstant: The time constant of the exponential decay applied to the trend velocity
+    ///   - minimumFitQuality: The minimum R² of the trend fit required to extend the projection
+    ///   - velocityMaximum: The limit on how fast the momentum effect can be. Defaults to 4 mg/dL/min based on physiological rates, if nil passed.
+    /// - Returns: An array of glucose effects
+    public func dampedMomentumEffect(
+        duration: TimeInterval = GlucoseMath.extendedMomentumDuration,
+        delta: TimeInterval = GlucoseMath.defaultDelta,
+        dampingTimeConstant: TimeInterval = GlucoseMath.momentumDampingTimeConstant,
+        minimumFitQuality: Double = GlucoseMath.dampedMomentumMinimumFitQuality,
+        velocityMaximum: HKQuantity? = nil
+    ) -> [GlucoseEffect] {
+
+        let velocityMax = velocityMaximum ?? HKQuantity(unit: HKUnit.milligramsPerDeciliter.unitDivided(by: .minute()), doubleValue: 4.0)
+
+        guard
+            self.count > 2,
+            isContinuous() && !containsCalibrations() && hasSingleProvenance,
+            let firstSample = self.first,
+            let lastSample = self.last,
+            let (startDate, endDate) = LoopMath.simulationDateRangeForSamples([lastSample], duration: duration, delta: delta)
+        else {
+            return []
+        }
+
+        let unit = HKUnit.milligramsPerDeciliter
+
+        let points = self.map { (
+            x: $0.startDate.timeIntervalSince(firstSample.startDate),
+            y: $0.quantity.doubleValue(for: unit)
+        ) }
+        let (slope: slope, intercept: intercept) = points.linearRegression()
+
+        guard slope.isFinite else {
+            return []
+        }
+
+        let lastChange = lastSample.quantity.doubleValue(for: unit) - self[self.endIndex - 2].quantity.doubleValue(for: unit)
+
+        guard
+            let fitQuality = points.coefficientOfDetermination(slope: slope, intercept: intercept),
+            fitQuality >= minimumFitQuality,
+            lastChange * slope > 0
+        else {
+            return linearMomentumEffect(delta: delta, velocityMaximum: velocityMaximum)
+        }
+
+        let limitedSlope = Swift.min(slope, velocityMax.doubleValue(for: unit.unitDivided(by: .second())))
+        let tau = Swift.max(dampingTimeConstant, 1)
+
+        var date = startDate
+        var values = [GlucoseEffect]()
+
+        repeat {
+            let elapsed = Swift.max(0, date.timeIntervalSince(lastSample.startDate))
+            let projected = limitedSlope * tau * (1 - exp(-elapsed / tau))
+            values.append(GlucoseEffect(startDate: date, quantity: HKQuantity(unit: unit, doubleValue: projected)))
+            date = date.addingTimeInterval(delta)
+        } while date <= endDate
+
+        return values
+    }
 }
 
 
