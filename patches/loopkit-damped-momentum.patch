diff --git a/LoopKit/LoopKitTests/GlucoseMathTests.swift b/LoopKit/LoopKitTests/GlucoseMathTests.swift
index 1cf6670..67c121d 100644
--- a/LoopKit/LoopKitTests/GlucoseMathTests.swift
+++ b/LoopKit/LoopKitTests/GlucoseMathTests.swift
@@ -316,3 +316,111 @@ class GlucoseMathTests: XCTestCase {
         }
     }
 }
+
+
+class DampedMomentumTests: XCTestCase {
+
+    private func samples(
+        _ values: [Double],
+        interval: TimeInterval = 300,
+        provenance: [String]? = nil,
+        startDate: Date = Date(timeIntervalSince1970: 0)
+    ) -> [GlucoseFixtureValue] {
+        values.enumerated().map { index, value in
+            GlucoseFixtureValue(
+                startDate: startDate.addingTimeInterval(Double(index) * interval),
+                quantity: HKQuantity(unit: .milligramsPerDeciliter, doubleValue: value),
+                isDisplayOnly: false,
+                wasUserEntered: false,
+                provenanceIdentifier: provenance?[index] ?? "com.loopkit.LoopKitTests",
+                condition: nil,
+                trendRate: nil
+            )
+        }
+    }
+
+    func testRisingGlucoseIsBoundedAndMonotonic() {
+        let input = samples([100, 105, 110, 115, 120, 125, 130])
+        let effects = input.dampedMomentumEffect(duration: .minutes(30))
+        XCTAssertGreaterThan(effects.count, 1)
+
+        let values = effects.map { $0.quantity.doubleValue(for: .milligramsPerDeciliter) }
+        for index in 1..<values.count {
+            XCTAssertGreaterThanOrEqual(values[index] + 1e-9, values[index - 1])
+        }
+        XCTAssertLessThan(values.last!, 30, "Damping must keep the projection below linear extrapolation")
+        XCTAssertGreaterThan(values.last!, 0)
+    }
+
+    func testFallingGlucoseProjectsNegative() {
+        let input = samples([130, 125, 120, 115, 110, 105, 100])
+        let effects = input.dampedMomentumEffect(duration: .minutes(30))
+        let values = effects.map { $0.quantity.doubleValue(for: .milligramsPerDeciliter) }
+        for index in 1..<values.count {
+            XCTAssertLessThanOrEqual(values[index] - 1e-9, values[index - 1])
+        }
+        XCTAssertLessThan(values.last!, 0)
+    }
+
+    func testProjectionExtendsBeyondLegacyFifteenMinuteWindow() {
+        let input = samples([100, 105, 110, 115, 120, 125, 130])
+        let effects = input.dampedMomentumEffect(duration: .minutes(30))
+        XCTAssertGreaterThanOrEqual(effects.last!.startDate.timeIntervalSince(input.last!.startDate), .minutes(29))
+    }
+
+    func testTooFewSamplesReturnsEmpty() {
+        XCTAssertTrue(samples([100, 105]).dampedMomentumEffect().isEmpty)
+    }
+
+    func testNonContinuousReturnsEmpty() {
+        XCTAssertTrue(samples([100, 105, 110, 115, 120], interval: 3600).dampedMomentumEffect().isEmpty)
+    }
+
+    func testMixedProvenanceReturnsEmpty() {
+        let input = samples([100, 105, 110, 115, 120], provenance: ["a", "a", "b", "b", "b"])
+        XCTAssertTrue(input.dampedMomentumEffect().isEmpty)
+    }
+
+    private func mgdL(_ effects: [GlucoseEffect]) -> [Double] {
+        effects.map { $0.quantity.doubleValue(for: .milligramsPerDeciliter) }
+    }
+
+    func testNoisyTrendFallsBackToLinearMomentum() {
+        let input = samples([100, 112, 101, 115, 104])
+        XCTAssertEqual(mgdL(input.dampedMomentumEffect()), mgdL(input.linearMomentumEffect()))
+    }
+
+    func testTurningPointFallsBackToLinearMomentum() {
+        // Rising overall, but the most recent reading dropped (e.g. peak after a meal)
+        let input = samples([100, 110, 120, 130, 128])
+        XCTAssertEqual(mgdL(input.dampedMomentumEffect()), mgdL(input.linearMomentumEffect()))
+    }
+
+    func testFlatGlucoseFallsBackToLinearMomentum() {
+        let input = samples([110, 110, 110, 110])
+        XCTAssertEqual(mgdL(input.dampedMomentumEffect()), mgdL(input.linearMomentumEffect()))
+    }
+
+    func testConsistentTrendProjectsFurtherThanLinearMomentum() {
+        let input = samples([130, 125, 120, 115, 110])
+        let damped = input.dampedMomentumEffect()
+        let linear = input.linearMomentumEffect()
+        XCTAssertGreaterThan(damped.count, linear.count)
+        XCTAssertLessThan(mgdL(damped).last!, mgdL(linear).last!)
+    }
+
+    func testPredictionAnticipatesFallingGlucoseMoreThanNoMomentum() {
+        let input = samples([130, 125, 120, 115, 110])
+        let momentum = input.dampedMomentumEffect(duration: .minutes(30))
+        let start = input.last!
+
+        let withMomentum = LoopMath.predictGlucose(startingAt: start, momentum: momentum, effects: [GlucoseEffect]())
+        let withoutMomentum = LoopMath.predictGlucose(startingAt: start, effects: [GlucoseEffect]())
+
+        let withMin = withMomentum.map { $0.quantity.doubleValue(for: .milligramsPerDeciliter) }.min()!
+        let withoutMin = withoutMomentum.map { $0.quantity.doubleValue(for: .milligramsPerDeciliter) }.min()!
+
+        XCTAssertLessThan(withMin, withoutMin)
+        XCTAssertLessThan(withMin, start.quantity.doubleValue(for: .milligramsPerDeciliter))
+    }
+}
