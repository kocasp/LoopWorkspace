+    /// Coefficient of determination (R²) of a linear fit, or nil when y has no variance
+    func coefficientOfDetermination(slope: Double, intercept: Double) -> Double? {
+        let meanY = reduce(0.0) { $0 + $1.y } / Double(count)
+        var totalSumOfSquares = 0.0
+        var residualSumOfSquares = 0.0
+
+        for point in self {
+            totalSumOfSquares += pow(point.y - meanY, 2)
+            residualSumOfSquares += pow(point.y - (slope * point.x + intercept), 2)
+        }
+
+        guard totalSumOfSquares > 0 else {
+            return nil
+        }
+
+        return 1 - residualSumOfSquares / totalSumOfSquares
+    }
 }
 
 
